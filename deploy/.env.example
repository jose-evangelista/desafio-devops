KORP_NETWORK_NAME=korp-net

KORP_APP_IMAGE=korp/http-server-projeto-korp
KORP_APP_VERSION=0.1.0
KORP_APP_COMMIT=none

KORP_NGINX_IMAGE=nginx:1.30.4-alpine
KORP_NGINX_HOST_PORT=80

KORP_PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
KORP_PROMETHEUS_HOST_PORT=9090
KORP_PROMETHEUS_RETENTION=15d

KORP_BLACKBOX_IMAGE=prom/blackbox-exporter:v0.28.0

KORP_GRAFANA_IMAGE=grafana/grafana:13.2.1
KORP_GRAFANA_HOST_PORT=3000
KORP_GRAFANA_ADMIN_USER=admin
KORP_GRAFANA_ADMIN_PASSWORD=admin
